# DocPilot environment placeholders — copy to .env and fill locally.
# Do NOT commit real secrets.

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DocPilot runtime
DOCPILOT_DATA_DIR=./data/sample_docs
DOCPILOT_INDEX_DIR=./indexes
DOCPILOT_EMBEDDING_MODEL=
DOCPILOT_TOP_K=5
DOCPILOT_REFUSE_THRESHOLD=0.35
DOCPILOT_LOG_LEVEL=INFO